# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Read by compose.yaml. The two credential variables have no defaults anywhere in the
# deployment path — compose fails fast if they are unset.

# --- Database (required) ---------------------------------------------------------------
DB_USER=serverregistry
# Generate one, do not invent one:  openssl rand -base64 24
DB_PASSWORD=
DB_NAME=serverregistry

# --- Where the API listens ------------------------------------------------------------
# Host interface to publish on. 127.0.0.1 keeps the API off the network: there is no
# authentication, and the check endpoint will connect to any address it is handed. Change
# this only once a reverse proxy or VPN is doing the authenticating.
APP_BIND=127.0.0.1
APP_PORT=8080

# --- Tuning (optional) ----------------------------------------------------------------
# Per-server TCP connect timeout for POST /api/servers/check. Probes run concurrently, so
# a request costs roughly this long in total, not this long per server.
HEALTHCHECK_TIMEOUT_MS=3000

# Container memory limit; the JVM heap follows at 75% of it.
APP_MEMORY_LIMIT=768m

# root logger: ERROR, WARN, INFO, DEBUG, TRACE
LOG_LEVEL=INFO
