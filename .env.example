# Required — compose.prod.yaml refuses to start without these set.

# See DEPLOY.md for what <db-host> should be depending on where Postgres runs.
DB_URL=jdbc:postgresql://host.docker.internal:5432/serverregistry
DB_USER=serverregistry
DB_PASSWORD=

# Everything below is optional — compose.prod.yaml already defaults each of these
# if left unset. Uncomment only the ones you need to override.

# APP_BIND=127.0.0.1              # interface the port publishes on — keep loopback, no auth on this API
# APP_PORT=8080                   # host-side port
# HEALTHCHECK_TIMEOUT_MS=3000     # per-server TCP probe timeout for POST /api/servers/check
# LOG_LEVEL=INFO                  # root log level
# APP_CPU_LIMIT=1.0               # hard CPU cap on the container
# APP_MEMORY_LIMIT=768m           # hard memory cap — JVM heap ceiling is 75% of this
