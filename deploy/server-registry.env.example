# Environment file for the systemd unit. Install as /etc/server-registry.env:
#
#   sudo install -m 600 -o root -g root deploy/server-registry.env.example \
#        /etc/server-registry.env
#   sudo editor /etc/server-registry.env
#
# systemd parses this itself, not through a shell: no quotes needed, no variable expansion,
# no comments at the end of a value line.

# --- Database (required) ---------------------------------------------------------------
# Unlike the compose path, nothing here can fail the start on a missing value: the
# application falls back to its development defaults (localhost, postgres/postgres). Set
# all three explicitly, then confirm with `systemctl show -p Environment server-registry`.
DB_URL=jdbc:postgresql://localhost:5432/serverregistry
DB_USER=serverregistry
DB_PASSWORD=

# --- Where the API listens ------------------------------------------------------------
# systemd cannot bind this to a single interface the way a Docker port mapping does — the
# JVM listens on all of them. The API has no authentication and the check endpoint will
# connect to any address it is given, so close 8080 at the firewall and reach it through a
# reverse proxy on the same host.
SERVER_PORT=8080

# --- Tuning (optional) ----------------------------------------------------------------
# Per-server TCP connect timeout for POST /api/servers/check. Probes run concurrently, so
# a request costs roughly this long in total, not this long per server.
HEALTHCHECK_TIMEOUT_MS=3000

# root logger: ERROR, WARN, INFO, DEBUG, TRACE
LOG_LEVEL=INFO
