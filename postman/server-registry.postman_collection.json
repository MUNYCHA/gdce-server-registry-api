{
  "info": {
    "name": "GDCE Server Registry & Reachability API",
    "description": "Admin API for registering servers and testing reachability.\n\nSet `baseUrl` to wherever the app is running (compose binds to 127.0.0.1:8080 by default).\n\n`Create` stores the new id in the `serverId` collection variable, so `Delete` works straight after it without editing the URL.\n\nContract: server_registry_api.md in the repository root.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "serverId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "updateTargetId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create server",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Capture the id so Delete can run against a row that exists.",
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set('serverId', pm.response.json().id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/servers",
          "host": ["{{baseUrl}}"],
          "path": ["api", "servers"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"hostname\": \"prod-db-01\",\n  \"ipAddress\": \"10.0.1.15\",\n  \"serverType\": \"DB\",\n  \"systemName\": \"BILLING\",\n  \"port\": 5432\n}",
          "options": { "raw": { "language": "json" } }
        },
        "description": "201 on success. `port` is optional and defaults to 22. 400 on validation failure, 409 when (ipAddress, port) is already registered."
      }
    },
    {
      "name": "Create server (no port, defaults to 22)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/servers",
          "host": ["{{baseUrl}}"],
          "path": ["api", "servers"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"hostname\": \"bastion\",\n  \"ipAddress\": \"10.0.9.4\",\n  \"serverType\": \" ssh \",\n  \"systemName\": \"CORE\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "description": "`serverType` is trimmed and uppercased on the way in, so this saves as \"SSH\". Omitted `port` saves as 22."
      }
    },
    {
      "name": "List servers",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/servers",
          "host": ["{{baseUrl}}"],
          "path": ["api", "servers"]
        },
        "description": "200 with every registered server, newest first. No parameters, no pagination. Empty array when there are no rows."
      }
    },
    {
      "name": "Update server",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/servers/{{serverId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "servers", "{{serverId}}"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"hostname\": \"prod-db-01-renamed\",\n  \"ipAddress\": \"10.0.1.15\",\n  \"serverType\": \"DB\",\n  \"systemName\": \"BILLING\",\n  \"port\": 5433\n}",
          "options": { "raw": { "language": "json" } }
        },
        "description": "200 with the updated row. Full replace, not a patch — every field is required, same validation as Create. `serverId` is set by the Create request. 404 if the id does not exist, 409 if (ipAddress, port) collides with a different row."
      }
    },
    {
      "name": "Distinct server types",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/servers/types",
          "host": ["{{baseUrl}}"],
          "path": ["api", "servers", "types"]
        },
        "description": "200 with each server_type value in use, sorted. Doubles as the container healthcheck endpoint — it exercises the web layer, JPA and a real database round trip."
      }
    },
    {
      "name": "Distinct systems",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/servers/systems",
          "host": ["{{baseUrl}}"],
          "path": ["api", "servers", "systems"]
        },
        "description": "200 with each system_name value in use, sorted. Lets the admin UI group servers by system and suggest existing names without restricting input."
      }
    },
    {
      "name": "Check all servers",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/servers/check",
          "host": ["{{baseUrl}}"],
          "path": ["api", "servers", "check"]
        },
        "description": "No request body. TCP-connects to every registered server concurrently and returns the results in list order.\n\nAlways 200 when the probing ran, including when every server is unreachable — servers being down is the answer, not an error.\n\nTakes roughly `healthcheck.timeout-ms` (3000 by default) when anything is down, regardless of how many servers are registered. Raise Postman's request timeout above that if you have changed it from the default of no limit."
      }
    },
    {
      "name": "Delete server",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/servers/{{serverId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "servers", "{{serverId}}"]
        },
        "description": "204 on success, 404 if the id does not exist. `serverId` is set by the Create request."
      }
    },
    {
      "name": "Error cases",
      "description": "All 4xx responses share one shape: timestamp, status, message, and — for validation failures only — a sorted `errors` array.",
      "item": [
        {
          "name": "400 — invalid IP address",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/servers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "servers"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hostname\": \"typo-box\",\n  \"ipAddress\": \"10.0.1.256\",\n  \"serverType\": \"WEB\",\n  \"systemName\": \"CORE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "400 \"Validation failed\". A bad octet has to be caught here — saved successfully it would surface later as a permanently unreachable server."
          }
        },
        {
          "name": "400 — port out of range",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/servers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "servers"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hostname\": \"bad-port\",\n  \"ipAddress\": \"10.0.1.20\",\n  \"serverType\": \"WEB\",\n  \"systemName\": \"CORE\",\n  \"port\": 70000\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "400. Port must be between 1 and 65535."
          }
        },
        {
          "name": "400 — malformed body",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/servers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "servers"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hostname\": \"unbindable\",\n  \"ipAddress\": \"10.0.1.21\",\n  \"serverType\": \"WEB\",\n  \"systemName\": \"CORE\",\n  \"port\": \"abc\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "400 \"Malformed request body\". Jackson cannot bind this, which happens before validation runs — hence a different message and no `errors` array."
          }
        },
        {
          "name": "409 — seed (create the row this test collides with)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/servers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "servers"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hostname\": \"dup-seed\",\n  \"ipAddress\": \"10.0.1.99\",\n  \"serverType\": \"DB\",\n  \"systemName\": \"CORE\",\n  \"port\": 5432\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Own dedicated (ipAddress, port) — not the one from the top-level 'Create server' request, which 'Delete server' removes earlier in a full collection run. Keeping this pair local to the folder means the 409 test below works whether you run the whole collection or just this folder on its own."
          }
        },
        {
          "name": "409 — duplicate IP and port",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/servers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "servers"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hostname\": \"dup-seed-again\",\n  \"ipAddress\": \"10.0.1.99\",\n  \"serverType\": \"DB\",\n  \"systemName\": \"CORE\",\n  \"port\": 5432\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "409, using the row the seed request just created. Same (ipAddress, port), different hostname — hostname is a display label and carries no uniqueness."
          }
        },
        {
          "name": "409 — update seed (row this update-conflict test targets)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Capture the id so the update-conflict test below has a row to PUT to.",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('updateTargetId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/servers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "servers"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hostname\": \"update-me\",\n  \"ipAddress\": \"10.0.1.97\",\n  \"serverType\": \"DB\",\n  \"systemName\": \"CORE\",\n  \"port\": 5432\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "A row distinct from 'dup-seed' above, so it can be updated into a collision without touching that row."
          }
        },
        {
          "name": "409 — update to duplicate IP and port",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/servers/{{updateTargetId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "servers", "{{updateTargetId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hostname\": \"update-me\",\n  \"ipAddress\": \"10.0.1.99\",\n  \"serverType\": \"DB\",\n  \"systemName\": \"CORE\",\n  \"port\": 5432\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "409 — 'dup-seed' above already owns (10.0.1.99, 5432)."
          }
        },
        {
          "name": "404 — update unknown id",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/servers/999999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "servers", "999999"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hostname\": \"ghost\",\n  \"ipAddress\": \"10.0.1.30\",\n  \"serverType\": \"DB\",\n  \"systemName\": \"CORE\",\n  \"port\": 22\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "404 \"No server with id 999999\"."
          }
        },
        {
          "name": "404 — delete unknown id",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/servers/999999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "servers", "999999"]
            },
            "description": "404 \"No server with id 999999\"."
          }
        }
      ]
    }
  ]
}
